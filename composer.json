{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "korafcloud/starter",
    "type": "project",
    "description": "A Laravel 12 + Livewire 3 starter kit styled with Tailwind CSS: user, role and permission management, two-factor authentication, social login, localization (English, Arabic, Kurdish) and a separate admin dashboard.",
    "keywords": [
        "laravel",
        "livewire",
        "tailwindcss",
        "starter-kit",
        "permissions",
        "two-factor-authentication",
        "socialite",
        "localization"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "bacon/bacon-qr-code": "^3.1",
        "blade-ui-kit/blade-heroicons": "^2.7",
        "jantinnerezo/livewire-alert": "^4.2",
        "laravel/framework": "^12.0",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^2.10.1",
        "livewire/livewire": "^3.8",
        "pragmarx/google2fa": "^9.0",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-translatable": "^6.14"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "christophrumpel/missing-livewire-assertions": "^2.11",
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-livewire": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --seed --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"npm run dev\" --names=server,queue,vite --kill-others"
        ],
        "logs": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan pail --timeout=0"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "lint": [
            "pint --parallel"
        ],
        "test:lint": [
            "pint --test"
        ],
        "review": [
            "@test:lint",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
